<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="sgu_pu" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.sgu.admissor.entity.BangQuyDoi</class>
        <class>com.sgu.admissor.entity.DiemCong</class>
        <class>com.sgu.admissor.entity.DiemThi</class>
        <class>com.sgu.admissor.entity.Nganh</class>
        <class>com.sgu.admissor.entity.NganhToHop</class>
        <class>com.sgu.admissor.entity.NguyenVong</class>
        <class>com.sgu.admissor.entity.Role</class>
        <class>com.sgu.admissor.entity.RoleDetail</class>
        <class>com.sgu.admissor.entity.RoleDetailId</class>
        <class>com.sgu.admissor.entity.SysFunction</class>
        <class>com.sgu.admissor.entity.ThiSinh2025</class>
        <class>com.sgu.admissor.entity.ToHop</class>
        <class>com.sgu.admissor.entity.User</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/sguadmissor?useSSL=false"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value="123456"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.hbm2ddl.auto" value="none"/>
            <property name="hibernate.jdbc.batch_size" value="50"/>
            <property name="hibernate.order_inserts" value="true"/>
            <property name="hibernate.order_updates" value="true"/>
        </properties>
    </persistence-unit>
</persistence>  