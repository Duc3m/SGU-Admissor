<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.sgu.admissor.entity.RoleDetail" table="role_detail">
        
        <composite-id name="id" class="com.sgu.admissor.entity.RoleDetailId">
            <key-property name="roleId" column="role_id"/>
            <key-property name="functionId" column="function_id"/>
        </composite-id>

        <property name="action" column="action" length="20"/>
        
    </class>
</hibernate-mapping>