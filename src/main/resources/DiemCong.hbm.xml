<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.sgu.admissor.entity.DiemCong" table="diemcong">
        <id name="id" column="id"><generator class="identity"/></id>
        <property name="cccd" column="cccd" length="45" not-null="true"/>
        <property name="maNganh" column="manganh" length="20"/>
        <property name="maToHop" column="matohop" length="10"/>
        <property name="phuongThuc" column="phuongthuc" length="45"/>
        <property name="diemCc" column="diemCC"/>
        <property name="diemUtxt" column="diemUtxt"/>
        <property name="diemTong" column="diemTong"/>
        <property name="ghiChu" column="ghichu" type="text"/>
        <property name="dcKey" column="dc_key" length="45" unique="true" not-null="true"/>
    </class>
</hibernate-mapping>