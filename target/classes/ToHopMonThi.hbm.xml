<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.sgu.admissor.entity.ToHopMonThi" table="tohop_monthi">
        <id name="id" column="id"><generator class="identity"/></id>
        <property name="maToHop" column="matohop" length="45" unique="true" not-null="true"/>
        <property name="mon1" column="mon1" length="10" not-null="true"/>
        <property name="mon2" column="mon2" length="10" not-null="true"/>
        <property name="mon3" column="mon3" length="10" not-null="true"/>
        <property name="tenToHop" column="tentohop" length="100"/>
    </class>
</hibernate-mapping>