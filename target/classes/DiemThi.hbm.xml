        <property name="ho" column="HO"/> <property name="si" column="SI"/>
        <property name="su" column="SU"/> <property name="di" column="DI"/>
        <property name="va" column="VA"/> <property name="n1Thi" column="N1_THI"/>
        <property name="n1Cc" column="N1_CC"/> <property name="cncn" column="CNCN"/>
        <property name="cnnn" column="CNNN"/> <property name="ti" column="TI"/>
        <property name="ktpl" column="KTPL"/> <property name="nl1" column="NL1"/>
