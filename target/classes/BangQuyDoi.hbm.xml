<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.sgu.admissor.entity.BangQuyDoi" table="bangquydoi">
        <id name="id" column="id">
            <generator class="identity"/>
        </id>
        <property name="phuongThuc" column="phuongthuc" length="45"/>
        <property name="toHop" column="tohop" length="45"/>
        <property name="mon" column="mon" length="45"/>
        <property name="diemA" column="diema"/> 
        <property name="diemB" column="diemb"/>
        <property name="diemC" column="diemc"/> 
        <property name="diemD" column="diemd"/>
        <property name="maQuyDoi" column="maquydoi" length="45" unique="true"/>
        <property name="phanVi" column="phanvi" length="45"/>
    </class>
</hibernate-mapping>